# ============================================
# SOCIALTOOL.STORE — Environment variables
# ============================================
# Энэ файлыг .env болгон хуулж, бодит утгуудаа оруулна уу.

# ---------- Database ----------
# SQLite файлын байрлал (Prisma)
DATABASE_URL=file:./db/custom.db

# ---------- Admin (dashboard /admin) ----------
# Анхны админ нэвтрэх нэр + нууц үг (продакшнд заавал өөрчилнө үү)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_strong_password_here
# JWT signing secret — урт, санамсаргүй үсэг/тоо
JWT_SECRET=CHANGE_ME_long_random_jwt_secret_at_least_32_chars

# ---------- Wire.mn Payment Integration ----------
# API base URL (production: https://api.wire.mn/v1)
WIRE_MN_API_URL=https://api.wire.mn/v1
# Live API key (sk_live_...) эсвэл test key (sk_test_...)
WIRE_MN_API_KEY=sk_live_REPLACE_WITH_YOUR_API_KEY
# Webhook signing secret — Wire.mn dashboard → Webhooks → endpoint-ийн signing secret
WIRE_MN_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_WEBHOOK_SIGNING_SECRET
# Allowed operators — comma-separated. Test-д ["sandbox"], live-д өөрийн оператор code
WIRE_MN_ALLOWED_OPERATORS=sandbox
# Demo горим: false (бодит API ашиглана), true (mock өгөгдөл)
WIRE_MN_DEMO_MODE=false

# ---------- Telegram Bot Notifications ----------
# @BotFather-оос авсан bot token
TELEGRAM_BOT_TOKEN=1234567890:AA_REPLACE_WITH_YOUR_BOT_TOKEN
# Admin chat ID — өөрийн Telegram ID (@userinfobot-оор олж болно)
TELEGRAM_ADMIN_CHAT_ID=REPLACE_WITH_YOUR_TELEGRAM_USER_ID

# ---------- Live chat service (socket.io mini-service) ----------
CHAT_SERVICE_PORT=3003

# ---------- Public site URL ----------
# Webhook success_url болон admin линкүүдэд ашиглагдана
# Пример: https://socialtool.store
NEXT_PUBLIC_SITE_URL=https://your-domain.com
