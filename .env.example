# Database
DATABASE_URL=file:./db/custom.db

# Admin bootstrap
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
JWT_SECRET=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Wire.mn
WIRE_MN_API_URL=https://api.wire.mn/v1
WIRE_MN_API_KEY=sk_test_REPLACE_ME
WIRE_MN_WEBHOOK_SECRET=whsec_REPLACE_ME
# Test key: sandbox is allowed. Live: use only active operator IDs, or leave empty if Wire should choose.
WIRE_MN_ALLOWED_OPERATORS=sandbox

# Public deployment URL
NEXT_PUBLIC_SITE_URL=https://socialtool.store

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# G2G official OpenAPI (optional supplier catalog sync)
# Request API Integration access in G2G, then generate the API/secret key.
# Keep these ONLY in Railway/hosting variables; never expose them to the browser.
G2G_API_KEY=
G2G_SECRET_KEY=
G2G_USER_ID=

# Legacy upload fallback (optional; new images are stored in DB)
UPLOAD_DIR=

# Optional chat mini-service
CHAT_SERVICE_PORT=3003
