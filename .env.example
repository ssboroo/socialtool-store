# Database
DATABASE_URL=file:./db/custom.db

# Admin bootstrap
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
JWT_SECRET=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Wire.mn
WIRE_MN_API_URL=https://api.wire.mn/v1
WIRE_MN_API_KEY=sk_test_REPLACE_ME
WIRE_MN_WEBHOOK_SECRET=whsec_REPLACE_ME
# Test key: sandbox is allowed. Live: use only active operator IDs, or leave empty if Wire should choose.
WIRE_MN_ALLOWED_OPERATORS=sandbox

# Public deployment URL
NEXT_PUBLIC_SITE_URL=https://socialtool.store

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# API-free supplier XML/CSV feed.
# *.eneba.com is allowed by default. Add extra supplier hosts as comma-separated domains.
# Example: feeds.example.com,cdn.example.com
SUPPLIER_FEED_ALLOWED_HOSTS=
# Optional secret for /api/cron/supplier-feed automatic sync.
SUPPLIER_FEED_CRON_SECRET=

# G2A Export API (optional marketplace connector)
# Requires a business-verified G2A seller account and Export API Credentials.
# Keep credentials ONLY in Railway/hosting variables; never expose them to the browser.
G2A_CLIENT_ID=
G2A_CLIENT_SECRET=
G2A_API_URL=https://api.g2a.com

# Optional G2G OpenAPI connector.
# CSV Supplier Import + Auto Markup + Publish works WITHOUT these variables.
# Configure only if G2G has explicitly approved OpenAPI access for your account.
G2G_API_KEY=
G2G_SECRET_KEY=
G2G_USER_ID=

# Legacy upload fallback (optional; new images are stored in DB)
UPLOAD_DIR=

# Optional chat mini-service
CHAT_SERVICE_PORT=3003
